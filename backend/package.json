{
  "name": "USOF_backend",
  "version": "1.8.9",
  "description": "own API service for USOF",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:admin": "node admin/server.js",
    "start:both": "concurrently \"node index.js\" \"node admin/server.js\"",
    "startf": "npm run start && npm run db_start",
    "dev": "concurrently \"node index.js\" \"node admin/server.js\"",
    "test": "echo \"No tests specified\" && exit 0",
    "db_start": "mysql -u root -p < db/db.sql",
    "db_install": "npm install mysql2"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/sql": "^2.2.6",
    "adminjs": "^7.8.17",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "nodemailer": "^7.0.6",
    "router": "^2.2.0",
    "sharp": "^0.34.4",
    "uuid": "^12.0.0",
    "vm2": "^3.9.19"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
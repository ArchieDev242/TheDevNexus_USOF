@startuml USOF_Deployment_Diagram
!theme plain
title TheDevNexus USOF - Deployment Diagram
skinparam backgroundColor #1a1a2e
skinparam defaultFontColor #ffffff
skinparam arrowColor #4db8ff
skinparam packageBackgroundColor #0f1a3e
skinparam databaseBackgroundColor #0f1a3e
skinparam nodeBackgroundColor #1f2b4d

' ============================================
' CLIENT DEVICES
' ============================================
actor User as user <<Browser>>

' ============================================
' INTERNET / NETWORK
' ============================================
package "INTERNET" #2a2a4e {
    ' Network connection
}

' ============================================
' FRONTEND SERVER
' ============================================
node "Frontend Server\n(React + Webpack)" as frontend #2d3e7f {
    component "React 18.3" as react
    component "Redux Toolkit" as redux
    component "React Router v7" as router
    component "i18next" as i18n
    component "Webpack Dev Server" as webpack
    
    react --> redux
    react --> router
    react --> i18n
    webpack --> react
}

' ============================================
' BACKEND SERVER
' ============================================
node "Backend Server\n(Node.js + Express)" as backend #2d3e7f {
    package "API Layer" #1f2b4d {
        component "Express.js 5.1" as express
        component "CORS Middleware" as cors
        component "JWT Auth" as jwt
        component "Cookie Parser" as cookies
    }
    
    package "Controllers" #1f2b4d {
        component "Users Controller" as users_ctrl
        component "Posts Controller" as posts_ctrl
        component "Comments Controller" as comments_ctrl
        component "Likes Controller" as likes_ctrl
        component "Categories Controller" as categories_ctrl
        component "Auth Controller" as auth_ctrl
    }
    
    package "Models & Data Access" #1f2b4d {
        component "User Model" as user_model
        component "Post Model" as post_model
        component "Comment Model" as comment_model
        component "Like Model" as like_model
        component "Category Model" as category_model
    }
    
    package "Utilities & Services" #1f2b4d {
        component "Email Service" as email_svc
        component "File Upload" as file_upload
        component "Rate Limiting" as rate_limit
        component "Admin Panel (AdminJS)" as admin_panel
    }
    
    express --> cors
    express --> jwt
    express --> cookies
    express --> users_ctrl
    express --> posts_ctrl
    express --> comments_ctrl
    express --> likes_ctrl
    express --> categories_ctrl
    express --> auth_ctrl
    
    users_ctrl --> user_model
    posts_ctrl --> post_model
    comments_ctrl --> comment_model
    likes_ctrl --> like_model
    categories_ctrl --> category_model
    
    users_ctrl --> file_upload
    auth_ctrl --> email_svc
    express --> rate_limit
    express --> admin_panel
}

' ============================================
' DATABASE SERVER
' ============================================
database "MySQL Database\n(MariaDB)" as db #2d3e7f {
    ' Tables representation
    collections "Tables" {
        card users_table as "users"
        card posts_table as "posts"
        card comments_table as "comments"
        card likes_table as "likes"
        card categories_table as "categories"
        card post_categories as "post_categories"
        card post_views as "post_views"
        card guest_sessions as "guest_sessions"
        card permissions as "permissions"
    }
}

' ============================================
' EXTERNAL SERVICES
' ============================================
node "External Services" as external #2d3e7f {
    component "Email Service\n(Nodemailer)" as nodemailer
    component "File Storage\n(Sharp)" as sharp
}

' ============================================
' CONNECTIONS
' ============================================
user --> frontend: HTTP/HTTPS
frontend --> backend: REST API\n(/api/*)
backend --> db: MySQL2\nConnection
backend --> external: SMTP/File Ops
backend --> admin_panel: Admin Dashboard

' Styling for connections
user -.-> frontend: 1. Request Page
frontend -.-> backend: 2. Fetch Data
backend -.-> db: 3. Query Data
db -.-> backend: 4. Return Data
backend -.-> frontend: 5. JSON Response
frontend -.-> user: 6. Render UI

@enduml
